# Copy this file to .env.local and use the pooled connection string from your Neon project.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
# Public HTTPS deployment URL. The Android app loads this live app so login and Neon API routes work.
CAPACITOR_SERVER_URL=https://your-app.example.com
# Vercel passes this value as a Bearer token when it calls /api/reminders/run.
CRON_SECRET=replace-with-a-long-random-secret
